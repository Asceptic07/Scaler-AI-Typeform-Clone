# Application title used in /health and OpenAPI documentation.
APP_NAME=Typeform Clone API
# Environment label for future environment-specific behavior.
APP_ENV=development
# Relative SQLite paths resolve from backend/. No tables are created at startup.
DATABASE_URL=sqlite:///./typeform_clone.db
# Exact browser origin allowed by CORS (no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000
